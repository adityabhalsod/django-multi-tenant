# ---------------------------------------------------------------------------
# Copy to .env (development) or .env.prod (production) and adjust.
# Every variable is documented in docs/05-configuration.md.
# ---------------------------------------------------------------------------

# --- Django ---------------------------------------------------------------
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
# Leading dot = the domain and all its subdomains (every tenant).
DJANGO_ALLOWED_HOSTS=.localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://*.localhost:8000

# Hostname of the public (platform) site. Tenants default to <name>.PUBLIC_DOMAIN.
PUBLIC_DOMAIN=localhost
APP_PORT=8000

# --- PostgreSQL container (docker compose) ----------------------------------
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_REPLICATION_PASSWORD=replicator

# --- Databases ------------------------------------------------------------
# Primary database (public schema + one schema per tenant). REQUIRED.
# Inside docker compose this is overridden to point at the "db" service.
DATABASE_URL=postgres://app:app@localhost:5432/app

# Optional read replicas, comma separated. With the compose "replica" profile:
# DATABASE_REPLICA_URLS=postgres://app:app@db-replica:5432/app
DATABASE_REPLICA_URLS=

# Optional extra (non tenant-aware) databases as alias=url pairs, and which
# apps live in them as app_label=alias pairs. Leave both empty to keep the
# analytics app in the primary database.
DATABASE_EXTRA_URLS=analytics=postgres://app:app@localhost:5432/analytics
DATABASE_APP_ROUTES=analytics=analytics

DB_CONN_MAX_AGE=60

# --- Redis / cache / Celery -------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Email (Mailpit in development: http://localhost:8025) ------------------
EMAIL_HOST=localhost
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=noreply@localhost

# --- Development helpers ----------------------------------------------------
USE_DEBUG_TOOLBAR=False
LOG_LEVEL=INFO

# --- Production only --------------------------------------------------------
# DJANGO_SETTINGS_MODULE=config.settings.production
# DJANGO_SECURE_SSL_REDIRECT=True
# SENTRY_DSN=
# USE_S3_MEDIA=False
# AWS_STORAGE_BUCKET_NAME=
